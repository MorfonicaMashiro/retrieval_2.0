<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" agent="Codex" version="24.7.17" pages="1">
  <diagram id="03_反演评定与实验分支" name="03_反演评定与实验分支">
    <mxGraphModel dx="1200" dy="510" grid="0" page="1" pageScale="1" pageWidth="1200" pageHeight="510" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ice" value="&lt;b&gt;路线 A：TB + 冰面干舷 FBice&lt;/b&gt;&lt;br&gt;候选 hs：0–1 m，每 4 cm 扫描&lt;br&gt;hi=(ρw·FBice+ρs·hs)/(ρw−ρi)&lt;br&gt;g(hs)=F(hi,hs,type)−TBobs；保留物理解&lt;br&gt;扫描命中或变号区间进入二分" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF3E5;strokeColor=#C78948;strokeWidth=2;fontSize=18;fontColor=#163428;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="545" height="152" as="geometry" />
        </mxCell>
        <mxCell id="snow" value="&lt;b&gt;路线 B：TB + 雪面干舷 FBsnow&lt;/b&gt;&lt;br&gt;候选 hs：0–min(1 m,FBsnow)，每 1 cm 全扫&lt;br&gt;hi=[ρw·FBsnow−(ρw−ρs)hs]/(ρw−ρi)&lt;br&gt;FBice=FBsnow−hs≥0；每个变号区间二分&lt;br&gt;保留全部根，验证默认取较小 hs 根" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF3E5;strokeColor=#C78948;strokeWidth=2;fontSize=18;fontColor=#163428;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="625" y="20" width="545" height="152" as="geometry" />
        </mxCell>
        <mxCell id="bisect" value="&lt;b&gt;共同求根与精度控制&lt;/b&gt;&lt;br&gt;|g|≤0.01 K 或雪深区间≤1e−5 m，最多 60 次；入表前再次校验 TB 残差&lt;br&gt;保存无根/双根、hi、hs、TBsim；不提前舍入；每条同日配对独立求解" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EDF5FA;strokeColor=#5286A3;strokeWidth=2;fontSize=18;fontColor=#163428;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="130" y="205" width="940" height="101" as="geometry" />
        </mxCell>
        <mxCell id="metrics" value="&lt;b&gt;误差评定&lt;/b&gt;&lt;br&gt;OIB 平均 hi/hs 作参照；TBOIB=F(hiOIB,hsOIB)&lt;br&gt;报告 n、bias、RMSE、r、R²、无根率/双根率&lt;br&gt;全部、逐年、nOIB 前 5%、1.5 K 诊断子集&lt;br&gt;1.5 K 子集不用于实际反演前筛选" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF5E9;strokeColor=#236431;strokeWidth=2;fontSize=18;fontColor=#163428;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="340" width="545" height="135" as="geometry" />
        </mxCell>
        <mxCell id="branches" value="&lt;b&gt;空间算子与后续测试分支&lt;/b&gt;&lt;br&gt;stride=1 重叠；stride=3 不重叠&lt;br&gt;A: F(mean hi,mean hs)；B: mean F(逐点 hi,hs)&lt;br&gt;Aw: 加权参数；Bw: 加权逐点 TB 后反演&lt;br&gt;权重：等面积子网格或中心反距离 w=d^(−p)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3EFFA;strokeColor=#8C75AB;strokeWidth=2;fontSize=17;fontColor=#163428;fontFamily=Microsoft YaHei;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="625" y="340" width="545" height="129" as="geometry" />
        </mxCell>
        <mxCell id="ice_b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#236431;strokeWidth=2;dashed=0;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="300" y="173" as="sourcePoint" />
            <mxPoint x="600" y="204" as="targetPoint" />
            <Array as="points">
              <mxPoint x="300" y="188" />
              <mxPoint x="600" y="188" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="snow_b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#236431;strokeWidth=2;dashed=0;endArrow=none;endFill=1;endSize=7;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="898" y="173" as="sourcePoint" />
            <mxPoint x="600" y="188" as="targetPoint" />
            <Array as="points">
              <mxPoint x="898" y="188" />
