        </mxCell>
        <mxCell id="b_m" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#236431;strokeWidth=2;dashed=0;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="600" y="307" as="sourcePoint" />
            <mxPoint x="302" y="339" as="targetPoint" />
            <Array as="points">
              <mxPoint x="600" y="322" />
