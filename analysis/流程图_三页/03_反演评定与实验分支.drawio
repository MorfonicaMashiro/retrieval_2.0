        <mxCell id="b_exp" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8C75AB;strokeWidth=2;dashed=1;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="600" y="322" as="sourcePoint" />
